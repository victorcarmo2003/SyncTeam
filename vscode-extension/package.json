{
  "name": "syncteam",
  "displayName": "SyncTeam",
  "description": "Sincroniza scripts Luau entre VS Code e Roblox Studio via Team Create, sem servidor externo.",
  "version": "0.1.0",
  "publisher": "dev-hakor",
  "license": "Apache-2.0",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/victorcarmo2003/SyncTeam.git"
  },
  "homepage": "https://github.com/victorcarmo2003/SyncTeam#readme",
  "bugs": {
    "url": "https://github.com/victorcarmo2003/SyncTeam/issues"
  },
  "keywords": [
    "roblox",
    "luau",
    "rojo",
    "team create",
    "live share"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/default.project.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "syncteam-logo": {
        "description": "Logo do SyncTeam",
        "default": { "fontPath": "./resources/syncteam-icons.woff", "fontCharacter": "\\F101" }
      }
    },
    "configuration": {
      "title": "SyncTeam",
      "properties": {
        "syncteam.port": {
          "type": "number",
          "default": 1400,
          "description": "Porta local (127.0.0.1) onde a extensão hospeda o servidor WebSocket para o plugin Studio conectar."
        },
        "syncteam.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Iniciar o servidor automaticamente ao ativar a extensão (quando há um default.project.json no workspace). Desligue para ativar sem subir o servidor e iniciá-lo manualmente com 'SyncTeam: Iniciar'."
        },
        "syncteam.multiSync": {
          "type": "boolean",
          "default": false,
          "description": "Permitir múltiplos Studios (plugins) conectados à mesma porta/extensão ao mesmo tempo — útil para testar multiplayer com 2 contas Roblox/2 Studios na mesma máquina e 1 VS Code só. Default (desligado): uma 2ª conexão é rejeitada (comportamento de sempre, 1 plugin por extensão)."
        }
      }
    },
    "commands": [
      {
        "command": "syncteam.refreshSync",
        "title": "SyncTeam: Refresh Sync (reconciliar disco e Studio)"
      },
      {
        "command": "syncteam.start",
        "title": "SyncTeam: Iniciar servidor"
      },
      {
        "command": "syncteam.stop",
        "title": "SyncTeam: Parar servidor"
      },
      {
        "command": "syncteam.restart",
        "title": "SyncTeam: Reiniciar servidor"
      },
      {
        "command": "syncteam.setPort",
        "title": "SyncTeam: Definir porta"
      },
      {
        "command": "syncteam.showOutput",
        "title": "SyncTeam: Mostrar log"
      }
    ]
  },
  "scripts": {
    "prebuild": "node scripts/build-icon-font.cjs",
    "build": "node esbuild.config.mjs",
    "build:icons": "node scripts/build-icon-font.cjs",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.21.0",
    "fantasticon": "^4.1.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
